		local chipBtns, scrolls, chipIndex, activeChip = {}, {}, {}, nil
		for i, name in ipairs(c.order) do chipIndex[name] = i end
		local function selectChip(name, instant)
			if name == activeChip then return end
			local prev, dir = activeChip, (activeChip and chipIndex[name] > chipIndex[activeChip]) and 1 or -1
			activeChip = name
			for n, b in pairs(chipBtns) do
				local sel = (n == name)
				tween(b, 0.25, {BackgroundColor3 = sel and RED or Color3.fromRGB(28, 22, 25), TextColor3 = WHITE})
			end
			if prev then
				local ph = scrolls[prev]
				tween(ph, 0.4, {Position = UDim2.fromOffset(10 - dir * (W - 20), 114)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
				task.delay(0.45, function() if activeChip ~= prev then pcall(function() ph.Visible = false end) end end)
			end
			local h = scrolls[name]
			if instant then h.Visible = true; h.Position = UDim2.fromOffset(10, 114)
			else
				h.Position = UDim2.fromOffset(10 + dir * (W - 20), 114); h.Visible = true
				tween(h, 0.4, {Position = UDim2.fromOffset(10, 114)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
			end
		end
		for i, name in ipairs(c.order) do
			local b = btn(p, {Size = UDim2.fromOffset(44, 18), Position = UDim2.fromOffset(22 + (i - 1) * 50, 90),
				BackgroundColor3 = Color3.fromRGB(28, 22, 25), Text = name, TextSize = 8}, {round()})
			chipBtns[name] = b
			local holder = new("Frame", {Size = UDim2.fromOffset(W - 20, H - 124), Position = UDim2.fromOffset(10, 114),
				BackgroundTransparency = 1, ClipsDescendants = true, Visible = false, BorderSizePixel = 0, Parent = p})
			local sc = newScroll(holder, 0, H - 124); sc.Position = UDim2.fromOffset(0, 0)
			scrolls[name] = holder
			for gi, g in ipairs(c.chips[name]) do
				buildGroup(sc, 12 + ((gi - 1) % 2) * 192, math.floor((gi - 1) / 2) * 100, g)
			end
			b.MouseButton1Click:Connect(function() selectChip(name) end)
		end
		selectChip(c.order[1], true)
	else
		local sc = newScroll(p, 92, H - 102)
		for i, r in ipairs(c.rows) do
			makeRow(sc, UDim2.fromOffset(12, (i - 1) * 34), UDim2.fromOffset(W - 44, 28), r[1], r[2], r[3], true)
		end
	end
end

