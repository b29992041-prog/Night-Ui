local function rbox(h, x, y, w, hh, r, filled, th)
	local f = new("Frame", {Size = UDim2.fromOffset(w, hh), Position = UDim2.fromOffset(x, y),
		BackgroundColor3 = RED, BackgroundTransparency = filled and 0 or 1, BorderSizePixel = 0, Parent = h}, {corner(r)})
