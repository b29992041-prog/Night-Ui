local conStep = RunService.RenderStepped:Connect(function(dt)
	pcall(function()
		if not win.Visible then return end
		t += dt
		local yaw, pitch, dist, bob = cs.yaw, cs.pitch, cs.dist, 0
		if idle then
			local s, amp = t - idleT0, math.clamp((t - idleT0) / 2, 0, 1)
			bob = math.sin(s * 0.8) * 0.02 * amp
			bgBreath = math.sin(s * 0.9) * 0.04 * amp; applyBg()
			local mp = UIS:GetMouseLocation()
			local c, k = win.AbsolutePosition + win.AbsoluteSize / 2, math.min(1, dt * 3)
			par.x += (math.clamp((mp.X - c.X) / 700, -0.6, 0.6) - par.x) * k
			par.y += (math.clamp((mp.Y - c.Y) / 500, -0.6, 0.6) - par.y) * k
			yaw += (math.sin(s * 0.55) * 0.07 - par.x * 0.14) * amp
			pitch += (math.sin(s * 0.4) * 0.015 + par.y * 0.05) * amp
			dist *= 1 + math.sin(s * 0.45) * 0.012 * amp
			v.LightDirection = Vector3.new(-0.5 + math.sin(s * 0.5) * 0.35, -1, 0.6 + math.cos(s * 0.4) * 0.25)
