local origText, dyn = {}, {}
local function translateText(orig)
	if LANG == "en" then return orig end
	if VI[orig] then return VI[orig] end
	local rest = orig:match("^PAGE / (.+)$")
	if rest then return VI["PAGE"] .. " / " .. (VI[rest] or rest) end
	return orig
end
local function registerTexts(root)
	for _, d in ipairs(root:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" and origText[d] == nil then
			origText[d] = d.Text
			if d.TextSize < 18 then
				d.TextScaled = true
				new("UITextSizeConstraint", {MaxTextSize = d.TextSize, MinTextSize = 4, Parent = d})
			end
		end
	end
end
local function applyLang()
	for obj, orig in pairs(origText) do
		pcall(function()
			if obj.Parent then obj.Text = dyn[obj] and dyn[obj]() or translateText(orig) end
		end)
	end
end
local function nt(en, vi) return LANG == "vi" and vi or en end
local langBtns = {}
local function refreshLangBtns()
	for l, b in pairs(langBtns) do
		local act = (l == LANG)
		tween(b, 0.2, {BackgroundColor3 = act and RED or Color3.fromRGB(36, 22, 26), TextColor3 = WHITE})
	end
end
local function setLang(l)
	if l == LANG then return end
	LANG = l; applyLang(); layoutNav(); refreshLangBtns()
	if Notify then
		local msg = (l == "vi") and "Đã chuyển sang Tiếng Việt" or "Switched to English"
		pcall(Notify, nt("Language", "Ngôn ngữ"), msg, "success", 2.5)
	end
	pcall(function() if writefile then writefile("NightZSeries_lang.txt", l) end end)
end

