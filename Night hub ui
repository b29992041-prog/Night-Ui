local function spaced(str)
	local words = {}
	for w in str:gmatch("%S+") do
		local chars = {}
		for _, c in utf8.codes(w) do table.insert(chars, utf8.char(c)) end
		table.insert(words, table.concat(chars, " "))
	end
	return table.concat(words, "   ")
end

