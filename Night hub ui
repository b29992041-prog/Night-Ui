local function makeRow(parent, pos, size, label, kind, default, withBg)
	local r = btn(parent, {Size = size, Position = pos, BackgroundColor3 = Color3.fromRGB(26, 18, 22),
		BackgroundTransparency = withBg and 0 or 1, Text = ""}, {corner(7)})
	text(r, {Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(10, 0), Text = label, TextSize = 8})
	if kind == "toggle" then
		local on = default or false
		local sw = new("Frame", {Size = UDim2.fromOffset(26, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
			BackgroundColor3 = on and RED or OFF, BorderSizePixel = 0, Parent = r}, {round()})
		local knob = new("Frame", {Size = UDim2.fromOffset(10, 10), Position = on and UDim2.fromOffset(14, 2) or UDim2.fromOffset(2, 2),
			BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = sw}, {round()})
		r.MouseButton1Click:Connect(function()
			on = not on
			tween(sw, 0.18, {BackgroundColor3 = on and RED or OFF})
			tween(knob, 0.32, {Position = on and UDim2.fromOffset(14, 2) or UDim2.fromOffset(2, 2)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			fire(label, on)
		end)
	elseif kind == "lang" then
		for i, l in ipairs({"en", "vi"}) do
			local active = (l == LANG)
			local b = btn(r, {Size = UDim2.fromOffset(32, 16), AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8 - (i - 1) * 36, 0.5, 0),
				BackgroundColor3 = active and RED or Color3.fromRGB(36, 22, 26), Text = l:upper(), TextSize = 8}, {round()})
			langBtns[l] = b
			b.MouseButton1Click:Connect(function() setLang(l) end)
		end
	else
		text(r, {Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
			Text = "›", TextSize = 14, TextColor3 = RED, TextXAlignment = Enum.TextXAlignment.Center})
		r.MouseButton1Click:Connect(function()
			r.BackgroundColor3 = RED_DARK; r.BackgroundTransparency = 0.15
			tween(r, 0.35, {BackgroundTransparency = withBg and 0 or 1, BackgroundColor3 = Color3.fromRGB(26, 18, 22)})
			fire(label)
		end)
	end
	return r
end

local function buildGroup(parent, x, y, def)
	local n = #def[4]
	local card = new("Frame", {Size = UDim2.fromOffset(186, 40 + n * 24 + 4), Position = UDim2.fromOffset(x, y),
		BackgroundColor3 = Color3.fromRGB(18, 15, 18), BorderSizePixel = 0, Parent = parent}, {corner(9), stroke(RED, 1, 0.65)})
	text(card, {Size = UDim2.fromOffset(120, 11), Position = UDim2.fromOffset(10, 8), Text = def[1], TextSize = 9, Font = Enum.Font.GothamBlack})
	text(card, {Size = UDim2.fromOffset(120, 16), Position = UDim2.fromOffset(10, 20), Text = def[2], TextSize = 6,
		TextColor3 = GRAY, Font = Enum.Font.Gotham, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top})
	iconBox(card, def[3], 186 - 32, 8, 22)
	for i, r in ipairs(def[4]) do
		makeRow(card, UDim2.fromOffset(6, 40 + (i - 1) * 24), UDim2.fromOffset(174, 22), r[1], r[2], r[3], false)
	end
end

local function newScroll(parent, y, h)
