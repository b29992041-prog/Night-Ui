local Notify, notifyAction, notifyEnabled = nil, nil, true
local function fire(name, ...)
	local args = {...}
	local f = Hooks[name]
	if f then
		task.spawn(function()
			local ok, err = pcall(f, table.unpack(args))
			if not ok then warn("[NightZSeries Hook Error]", name, err) end
		end)
	else
		pcall(print, "[NightZSeries]", name, table.unpack(args))
	end
	if notifyAction then
		pcall(notifyAction, name, table.unpack(args))
	end
end

