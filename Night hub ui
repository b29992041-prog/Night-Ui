local function setBg(target, dur)
	bgToken += 1
	local token, from = bgToken, bgAlpha
	numTween(0, 1, dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, function(a)
		if token ~= bgToken then return end
		bgAlpha = from + (target - from) * a
		applyBg()
	end)
end

