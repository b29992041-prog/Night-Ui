local function poly(h, pts, th)
	for i = 1, #pts - 1 do line(h, pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], th or 1.7, RED) end
end
local function drawIcon(kind, h, col)
	col = col or RED
	local asset = ICON_ASSETS[kind]
	if asset then
		new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit,
			Image = "rbxassetid://" .. string.format("%.0f", asset), ImageColor3 = col, Parent = h})
		return
	end
	if kind == "crown" then
		poly(h, {{2.5, 14}, {2.5, 6.5}, {6.2, 10}, {9, 4}, {11.8, 10}, {15.5, 6.5}, {15.5, 14}}, 1.6)
		line(h, 2.5, 15.5, 15.5, 15.5, 1.8, col); dot(h, 2.5, 5.8, 2.4, col); dot(h, 9, 3.2, 2.4, col); dot(h, 15.5, 5.8, 2.4, col)
