	end)
	card.MouseLeave:Connect(function()
		tween(st, 0.2, {Transparency = 0.65})
		tween(card, 0.25, {Position = normalPos}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	end)
end

local fadeData = {}
local function prepFade(root)
	local list = {}
	local function add(o, prop)
		local ok, val = pcall(function() return o[prop] end)
		if ok then
			table.insert(list, {o, prop, val})
			pcall(function() o[prop] = 1 end)
		end
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			add(d, "TextTransparency"); add(d, "BackgroundTransparency")
		elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
			add(d, "ImageTransparency"); add(d, "BackgroundTransparency")
		elseif d:IsA("GuiObject") then
			add(d, "BackgroundTransparency")
		elseif d:IsA("UIStroke") then
			add(d, "Transparency")
		end
	end
	fadeData[root] = list
end
local function fadeIn(root, dur, delay)
	for _, e in ipairs(fadeData[root] or {}) do
		tween(e[1], dur, {[e[2]] = e[3]}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, delay)
	end
end

local function assetInfo(id)
	local ok, r = pcall(function() return MarketplaceService:GetProductInfo(id) end)
	return ok and r or nil
end
local function resolveImage(id)
	local url = "rbxassetid://" .. string.format("%.0f", id)
	local base = assetInfo(id)
	if base and base.AssetTypeId == 1 then return url, "ok" end
	for _, off in ipairs({-1, 1, -2, 2}) do
		local ci = assetInfo(id + off)
		if ci and ci.AssetTypeId == 1 and (not base or ci.Name == base.Name) then
			return "rbxassetid://" .. string.format("%.0f", id + off), "near"
		end
	end
	return url, "fallback"
end

