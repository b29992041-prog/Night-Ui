local cs = {yaw = FRONT_YAW, pitch = 0.08, dist = 14, ty = 0.4, tx = 0}
local baseDist = 12.7
local SCENES = {
	home  = {yaw = IDLE_YAW,       pitch = 0.12, dist = 1.02, ty = 0.5,  tx = 0,    dim = 0,    bg = 0, nav = "Home"},
	page  = {yaw = math.pi + 0.95, pitch = 0.05, dist = 0.95, ty = 0.35, tx = 0,    dim = 0.86, bg = 1, nav = "Page"},
	about = {yaw = math.pi + 1.18, pitch = 0.06, dist = 0.94, ty = 0.34, tx = 1.65, dim = 0,    bg = 1, nav = "About"},
}
local curScene, sceneToken = "home", 0
local function applyScene(name)
	if name == curScene then return end
	curScene = name
	local sc = SCENES[name]
	if not sc then return end
	sceneToken += 1
	local token = sceneToken
	local f = {yaw = cs.yaw, pitch = cs.pitch, dist = cs.dist, ty = cs.ty, tx = cs.tx}
	numTween(0, 1, 1.1, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut, function(a)
		if token ~= sceneToken then return end
		cs.yaw = f.yaw + (sc.yaw - f.yaw) * a
		cs.pitch = f.pitch + (sc.pitch - f.pitch) * a
		cs.dist = f.dist + (baseDist * sc.dist - f.dist) * a
		cs.ty = f.ty + (sc.ty - f.ty) * a
		cs.tx = f.tx + (sc.tx - f.tx) * a
	end)
	tween(v, 0.7, {ImageTransparency = sc.dim})
	setBg(sc.bg == 0 and 1 or 0, 0.5)
	setNav(sc.nav)
end

local onShow, SLIDE_T = {}, 0.6
local function showPage(p)
	if not p or p == cur then return end
	local dir = (pageOrder[p] > (cur and pageOrder[cur] or 0)) and 1 or -1
	local oldP = cur
	cur = p
	if oldP then
		tween(oldP, SLIDE_T, {Position = UDim2.fromOffset(W / 2 - dir * W, H / 2)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
		task.delay(SLIDE_T + 0.05, function() if cur ~= oldP then pcall(function() oldP.Visible = false end) end end)
	end
	p.Position = UDim2.fromOffset(W / 2 + dir * W, H / 2)
	if scales[p] then scales[p].Scale = 1 end
	p.Visible = true
	tween(p, SLIDE_T, {Position = UDim2.fromOffset(W / 2, H / 2)}, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
	if onShow[p] then pcall(onShow[p]) end
end
go = function(p, scene)
	if not ready or not p or p == cur then return end
	showPage(p); applyScene(scene)
end

