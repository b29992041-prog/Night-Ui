-- ================= UI HELPER =================
local function new(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		pcall(function() o[k] = v end)
	end
	for _, c in ipairs(kids or {}) do
		pcall(function() c.Parent = o end)
	end
	return o
end
local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r)}) end
local function round() return new("UICorner", {CornerRadius = UDim.new(1, 0)}) end
local function stroke(col, th, tr) return new("UIStroke", {Color = col or RED, Thickness = th or 1, Transparency = tr or 0}) end
local function text(parent, props)
	local o = {
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold, TextColor3 = WHITE, Parent = parent,
	}
	for k, v in pairs(props or {}) do o[k] = v end
	return new("TextLabel", o)
end
local function btn(parent, props, kids)
	local o = {
		BackgroundColor3 = Color3.fromRGB(28, 22, 25), TextColor3 = WHITE,
		Font = Enum.Font.GothamBold, AutoButtonColor = false, BorderSizePixel = 0, Parent = parent,
	}
	for k, v in pairs(props or {}) do o[k] = v end
	return new("TextButton", o, kids)
end
local function line(parent, x1, y1, x2, y2, th, col)
	local dx, dy = x2 - x1, y2 - y1
	return new("Frame", {
		Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), th or 1.5),
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		AnchorPoint = Vector2.new(0.5, 0.5), Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = col or RED, BorderSizePixel = 0, Parent = parent,
	}, {round()})
end
local function ring(parent, x, y, w, h, col)
	return new("Frame", {Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y),
		BackgroundTransparency = 1, Parent = parent}, {round(), stroke(col or RED, 1.5)})
end
local function tween(obj, dur, props, style, dir, delay)
	local ok, tw = pcall(function()
		local t = TweenService:Create(obj, TweenInfo.new(dur, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.InOut, 0, false, delay or 0), props)
		t:Play()
		return t
	end)
	return ok and tw or nil
end
local function numTween(from, to, dur, style, dir, fn)
	local nv = Instance.new("NumberValue")
	nv.Value = from
	local c = nv.Changed:Connect(function(val) pcall(fn, val) end)
	local tw = tween(nv, dur, {Value = to}, style, dir)
	if tw then
		tw.Completed:Once(function() c:Disconnect(); nv:Destroy() end)
	else
		c:Disconnect(); nv:Destroy()
	end
	return tw
end
local function hoverCard(card, st, normalPos, lift)
	lift = lift or 2
	card.MouseEnter:Connect(function()
